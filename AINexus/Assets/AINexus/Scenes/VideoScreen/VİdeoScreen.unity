      m_Calls: []
  m_text: "\n\n\n\n\n\n\nRizzle AI, metinleri otomatik olarak sosyal medya format\u0131na
    uygun videolara d\xF6n\xFC\u015Ft\xFCren bir yapay zeka platformudur. \xD6zellikle
    i\xE7erik \xFCreticiler, blog yazarlar\u0131 ve pazarlamac\u0131lar i\xE7in geli\u015Ftirilmi\u015Ftir.
    Kullan\u0131c\u0131 yaln\u0131zca bir metin girerek, platformun otomatik olarak
    g\xF6rseller, ge\xE7i\u015F efektleri ve altyaz\u0131larla dolu k\u0131sa videolar
    \xFCretmesini sa\u011Flayabilir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
