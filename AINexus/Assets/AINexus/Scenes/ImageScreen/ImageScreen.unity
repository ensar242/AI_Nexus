      m_Calls: []
  m_text: "\n\n\n\n\n\n\nHailuo AI, \xC7in merkezli MiniMax taraf\u0131ndan geli\u015Ftirilen,
    metin ve g\xF6rsellerden k\u0131sa videolar \xFCretebilen bir yapay zeka platformudur.
    Kullan\u0131c\u0131lar, yaz\u0131l\u0131 a\xE7\u0131klamalar veya g\xF6rseller
    arac\u0131l\u0131\u011F\u0131yla sinematik efektlerle zenginle\u015Ftirilmi\u015F
    videolar olu\u015Fturabilirler. Platform, \xF6zellikle i\xE7erik \xFCreticileri,
    e\u011Fitimciler ve pazarlamac\u0131lar i\xE7in h\u0131zl\u0131 ve etkili video
    \xFCretimi sunar."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
