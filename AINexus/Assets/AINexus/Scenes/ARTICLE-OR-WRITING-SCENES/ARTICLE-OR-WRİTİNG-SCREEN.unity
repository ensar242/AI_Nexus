  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "* H\u0131zl\u0131ca notlar alan yapay zeka bir video y\xFCkledi\u011Finde
    notlar\u0131 al\u0131p ingilizce verir t\xFCrk\xE7esini de\u011Fi\u015Ftirir
    ya da senin kaydetti\u011Fin sesleri de metine \xE7evirebiiliyor\n\n*AI Destekli
    \xC7al\u0131\u015Fma Ara\xE7lar\u0131: GPT-3.5 veya GPT-4 teknolojisiyle desteklenen
    \xE7al\u0131\u015Fma kartlar\u0131, uyarlanabilir quizler ve sohbet robotu yard\u0131m\u0131
    sunar. \n\n* Notion Tarz\u0131 Not Edit\xF6r\xFC: Kullan\u0131c\u0131lar\u0131n
    d\xFC\u015F\xFCncelerini ve fikirlerini d\xFCzenlemeleri i\xE7in kullan\u0131c\u0131
    dostu bir not alma arac\u0131 sa\u011Flar.\n\n* \xD6zel Ders Pazaryeri: Platform
    \xFCzerinden uygun fiyatl\u0131 \xF6zel ders hizmetlerine eri\u015Fim imkan\u0131
    tan\u0131r. \n\n* Aral\u0131kl\u0131 Tekrar Sistemi: Hem manuel hem de AI taraf\u0131ndan
    olu\u015Fturulan \xE7al\u0131\u015Fma kartlar\u0131 i\xE7in aral\u0131kl\u0131
    tekrar tekniklerini uygular. \n\n* Dosya Y\xFCkleme ve Y\xF6netimi: Kullan\u0131c\u0131lar\u0131n
    \xE7al\u0131\u015Fma materyallerini y\xFCklemelerine ve depolamalar\u0131na olanak
    tan\u0131r; dosya boyutu s\u0131n\u0131rlar\u0131 abonelik plan\u0131na g\xF6re
    de\u011Fi\u015Fir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
