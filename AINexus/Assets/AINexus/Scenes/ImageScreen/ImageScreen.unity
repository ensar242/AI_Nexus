      m_Calls: []
  m_text: "Fiyatland\u0131rma (2025 itibar\u0131yla)\n\n\xDCcretsiz Plan: \nG\xFCnde
    1 video, s\u0131n\u0131rl\u0131 avatar se\xE7imi, filigranl\u0131 i\xE7erik.\n\nStarter
    Plan: \nAyl\u0131k 12$, haftal\u0131k 10 video, temel avatarlar, ses sentezi.\n\nPro
    Plan:\n Ayl\u0131k 39$, s\u0131n\u0131rs\u0131z video \xFCretimi, premium avatarlar,
    \xF6zel ses profilleri.\n\nBusiness Plan: \nAyl\u0131k 89$, \xE7oklu ekip deste\u011Fi,
    \xF6zel marka avatar\u0131, API eri\u015Fimi."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
