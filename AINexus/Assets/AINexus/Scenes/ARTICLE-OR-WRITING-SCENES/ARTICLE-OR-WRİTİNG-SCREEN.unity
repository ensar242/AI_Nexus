  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "* Y\xFCkseklik Ayarlama: Kullan\u0131c\u0131lar, farkl\u0131 y\xFCkseklik
    seviyelerini ayarlayarak d\xFCnya \xFCzerindeki \xE7e\u015Fitli b\xF6lgeleri
    detayl\u0131 bir \u015Fekilde inceleyebilirler.\n\n* Manzara De\u011Fi\u015Ftirme:
    Gezegenimizin manzaras\u0131n\u0131 de\u011Fi\u015Ftirerek farkl\u0131 co\u011Frafi
    \xF6zellikleri ke\u015Ffetme imkan\u0131 sunar.\n\n* Etkileyici Ke\u015Fif Deneyimi:
    Everest Da\u011F\u0131'n\u0131n zirvesinden Mariana \xC7ukuru'nun derinliklerine
    kadar uzanan sanal bir ke\u015Fif yolculu\u011Fu sa\u011Flar\n\n* Ara\u015Ft\u0131rmay\u0131
    vegezmeyi en ince ayr\u0131nt\u0131s\u0131na kadar sana ne yapabilece\u011Fiini
    g\xF6steren yapay zeka."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
