  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n\n\n\n\n\nLuma Labs AI, metin ve g\xF6rsellerden y\xFCksek kaliteli,
    ger\xE7ek\xE7i videolar ve 3D i\xE7erikler olu\u015Fturan bir yapay zeka platformudur.
    \xD6zellikle Dream Machine arac\u0131, kullan\u0131c\u0131lar\u0131n basit metin
    a\xE7\u0131klamalar\u0131 veya g\xF6rsellerle sinematik videolar \xFCretmelerine
    olanak tan\u0131r."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
