  m_text: "\n\n\n\n\n\n\nFaceless AI, y\xFCz\xFCn\xFCz\xFC g\xF6stermeden profesyonel
    g\xF6r\xFCn\xFCml\xFC video i\xE7erikleri olu\u015Fturman\u0131z\u0131 sa\u011Flayan
    yapay zeka destekli bir video \xFCretim platformudur. Metinden video olu\u015Fturma,
    AI avatarlar, ses sentezi ve senaryo y\xF6netimi gibi \xF6zelliklerle, \xF6zellikle
    i\xE7erik \xFCreticiler ve markalar i\xE7in y\xFCzs\xFCz i\xE7erik \xFCretimini
    kolayla\u015Ft\u0131r\u0131r."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
