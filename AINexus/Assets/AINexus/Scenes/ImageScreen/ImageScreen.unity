  m_text: "\n\n\n\n\n\n\nVideoEffects AI, video d\xFCzenleme s\xFCrecini kolayla\u015Ft\u0131rmak
    i\xE7in yapay zeka destekli efektler sunan bir platformdur. Kullan\u0131c\u0131lar,
    metin komutlar\u0131yla video d\xFCzenlemeleri yapabilir, sahneleri de\u011Fi\u015Ftirebilir
    ve \xE7e\u015Fitli g\xF6rsel efektler ekleyebilirler."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
