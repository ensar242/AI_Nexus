      m_Calls: []
  m_text: "\n\n\n\n\n\n\nOpusClip, uzun videolar\u0131 k\u0131sa ve dikkat \xE7ekici
    kliplere d\xF6n\xFC\u015Ft\xFCren yapay zeka destekli bir video d\xFCzenleme
    arac\u0131d\u0131r. \xD6zellikle i\xE7erik \xFCreticileri, sosyal medya y\xF6neticileri
    ve dijital pazarlamac\u0131lar i\xE7in uygundur. TikTok, YouTube Shorts ve Instagram
    Reels gibi platformlara uygun dikey formatta videolar \xFCretir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
