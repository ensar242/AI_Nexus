      m_Calls: []
  m_text: "Fiyatland\u0131rma (2025 itibar\u0131yla)\n\n\xDCcretsiz Plan: \nAyl\u0131k
    30 video \xFCretimi, ticari olmayan kullan\u0131m.\n\nLite Plan:\n Ayl\u0131k
    7.99$, 70 \xFCretim, y\xFCksek \xF6ncelik, ticari olmayan kullan\u0131m.\n\nStandart
    Plan:\n Ayl\u0131k 23.99$, 150 \xFCretim, ticari kullan\u0131m, filigran kald\u0131rma.\n\nPlus
    Plan:\n Ayl\u0131k 51.99$, 310 \xFCretim, en y\xFCksek \xF6ncelik, ticari kullan\u0131m.\n\nPro
    Plan:\n Ayl\u0131k 79.99$, 480 \xFCretim, en y\xFCksek \xF6ncelik, ticari kullan\u0131m."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
