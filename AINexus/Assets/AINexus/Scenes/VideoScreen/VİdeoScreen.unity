      m_Calls: []
  m_text: "\n\n\n\n\n\n\nNisan 2025 itibar\u0131yla, Sora hen\xFCz kamuya a\xE7\u0131k
    olarak sunulmam\u0131\u015Ft\u0131r. \u015Eu anda yaln\u0131zca se\xE7ili i\xE7erik
    \xFCreticileri ve i\u015F ortaklar\u0131 taraf\u0131ndan test edilmektedir. Bu
    nedenle:\n\n*Fiyatland\u0131rma resmi olarak a\xE7\u0131klanmam\u0131\u015Ft\u0131r.\n\n*OpenAI'nin
    di\u011Fer \xFCr\xFCnleri gibi (ChatGPT Plus gibi) abonelik temelli bir sistem
    kullanmas\u0131 beklenmektedir.\n\n*Kullan\u0131ma dayal\u0131 \xFCcretlendirme
    (\xFCretilecek video s\xFCresine veya \xE7\xF6z\xFCn\xFCrl\xFC\u011Fe g\xF6re)
    olas\u0131l\u0131\u011F\u0131 da y\xFCksektir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
