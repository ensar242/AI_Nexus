      m_Calls: []
  m_text: "\n\n\n\n\n\n\nHitPaw, video ve ses d\xFCzenleme, medya d\xF6n\xFC\u015Ft\xFCrme,
    yapay zeka destekli g\xF6r\xFCnt\xFC iyile\u015Ftirme ve i\xE7erik olu\u015Fturma
    ara\xE7lar\u0131 sunan hepsi bir arada bir medya yaz\u0131l\u0131m platformudur.
    Hem bireysel i\xE7erik \xFCreticiler hem de profesyonel kullan\u0131c\u0131lar
    i\xE7in pratik ve g\xFC\xE7l\xFC \xE7\xF6z\xFCmler sa\u011Flar.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
