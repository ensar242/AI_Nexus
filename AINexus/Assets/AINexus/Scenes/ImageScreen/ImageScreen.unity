      m_Calls: []
  m_text: "Test My Thumbnails AI, YouTube i\xE7erik \xFCreticileri i\xE7in geli\u015Ftirilmi\u015F
    yapay zeka destekli bir k\xFC\xE7\xFCk resim (thumbnail) analiz ve optimizasyon
    arac\u0131d\u0131r. Bu platform, kullan\u0131c\u0131lar\u0131n videolar\u0131
    i\xE7in etkileyici k\xFC\xE7\xFCk resimler olu\u015Fturmas\u0131na ve bu resimlerin
    performans\u0131n\u0131 de\u011Ferlendirmesine yard\u0131mc\u0131 olur. Ayr\u0131ca,
    A/B testleri yaparak farkl\u0131 k\xFC\xE7\xFCk resim ve ba\u015Fl\u0131k kombinasyonlar\u0131n\u0131n
    etkinli\u011Fini kar\u015F\u0131la\u015Ft\u0131rma imkan\u0131 sunar.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
