      m_Calls: []
  m_text: "\n\n\n\n\n\n\nHedra AI, video ve ses i\xE7eriklerini \xE7ok dilli olarak
    klonlay\u0131p yerelle\u015Ftiren, yapay zeka tabanl\u0131 g\xFC\xE7l\xFC bir
    i\xE7erik uyarlama platformudur. \xD6zellikle k\xFCresel i\xE7erik \xFCreticileri,
    e\u011Fitim platformlar\u0131 ve medya \u015Firketleri i\xE7in ki\u015Fiselle\u015Ftirilmi\u015F
    ve ger\xE7ek\xE7i \xE7eviri \xE7\xF6z\xFCmleri sunar."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
