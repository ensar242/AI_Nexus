  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Fiyatland\u0131rma (2025 itibar\u0131yla)\n\n\xDCcretsiz Plan:\nS\u0131n\u0131rs\u0131z
    AI sohbet aramalar\u0131, 10 AI g\xF6rsel \xFCretimi ve 10 AI yaz\u0131 \xFCretimi
    sunar. Standart AI sohbet s\xFCresi ve sohbet ge\xE7mi\u015Fi y\xF6netimi dahildir.
    \n\nYouPro Plan\u0131:\nAyl\u0131k 15 USD (y\u0131ll\u0131k \xF6deme ile). GPT-4o,
    OpenAI o1 ve Claude 3.5 Sonnet dahil t\xFCm AI modellerine eri\u015Fim, 25MB'a
    kadar dosya y\xFCkleme ve Google Drive entegrasyonu, 64k ba\u011Flam penceresi,
    GenAI e\u011Fitimi ve sertifikasyonu, ara\u015Ft\u0131rma ve \xF6zel ajanlara
    eri\u015Fim sunar. \n\nYouPro E\u011Fitim Plan\u0131:\n\xD6\u011Frenciler ve
    \xF6\u011Fretmenler i\xE7in indirimli fiyatlarla YouPro plan\u0131n\u0131n t\xFCm
    avantajlar\u0131n\u0131 sunar. \n\nTak\u0131m Plan\u0131:\nAyl\u0131k 25 USD
    (y\u0131ll\u0131k \xF6deme ile). YouPro plan\u0131n\u0131n t\xFCm \xF6zelliklerine
    ek olarak s\u0131n\u0131rs\u0131z sorgu, 50MB'a kadar dosya y\xFCkleme, 200k
    ba\u011Flam penceresi, s\u0131f\u0131r veri saklama ve model e\u011Fitimi olmadan
    kullan\u0131m imkan\u0131 sunar. \nyou.com\n\nKurumsal Plan:\n\xD6zel fiyatland\u0131rma
    ile sunulur. Tak\u0131m plan\u0131n\u0131n t\xFCm \xF6zelliklerine ek olarak
    \xF6zel hesap y\xF6neticisi, \xF6ncelikli destek, izin ve eri\u015Fim \xFCzerinde
    ayr\u0131nt\u0131l\u0131 kontrol, 100KB'den 100TB+'a kadar \xF6zel veri eri\u015Fimi
    ve \xF6zel RAG (Retrieval-Augmented Generation) sunar."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
