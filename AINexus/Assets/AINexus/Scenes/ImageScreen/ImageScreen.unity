      m_Calls: []
  m_text: "* Canl\u0131 \xD6nizleme: K\xFC\xE7\xFCk resimlerinizi YouTube aray\xFCz\xFCnde
    ger\xE7ek zamanl\u0131 olarak \xF6nizleyerek nas\u0131l g\xF6r\xFCnd\xFC\u011F\xFCn\xFC
    g\xF6rebilirsiniz.\n\n* A/B Testi: Ayn\u0131 video i\xE7in birden fazla k\xFC\xE7\xFCk
    resim ve ba\u015Fl\u0131k kombinasyonunu test ederek en etkili olan\u0131 belirleyebilirsiniz.\n\n*
    AI Destekli Olu\u015Fturucu: Yapay zeka yard\u0131m\u0131yla metin girdilerine
    dayal\u0131 olarak otomatik k\xFC\xE7\xFCk resimler olu\u015Fturabilirsiniz.\n\n*
    Performans Skoru: K\xFC\xE7\xFCk resimlerinizin t\u0131klanma oran\u0131 potansiyelini
    de\u011Ferlendiren AI tabanl\u0131 puanlama sistemi.\n\n* \u0130lham Galerisi:
    100.000'den fazla ba\u015Far\u0131l\u0131 k\xFC\xE7\xFCk resim \xF6rne\u011Fiyle
    ilham alabilece\u011Finiz bir k\xFCt\xFCphane."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
