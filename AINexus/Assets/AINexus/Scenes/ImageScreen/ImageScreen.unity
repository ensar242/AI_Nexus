  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Fiyatland\u0131rma (2025 itibar\u0131yla)\n\xDCcretsiz Plan:\nG\xFCnl\xFCk
    s\u0131n\u0131rl\u0131 say\u0131da kaliteli ve ger\xE7ek zamanl\u0131 g\xF6rsel
    \xFCretimi, \xFCretimler aras\u0131nda bekleme s\xFCresi.\n\nExplorer Plan:\nAyl\u0131k
    7.99$, y\u0131ll\u0131k 79$; y\u0131lda 600 kredi, s\u0131n\u0131rs\u0131z ger\xE7ek
    zamanl\u0131 g\xF6rsel \xFCretimi, video olu\u015Fturma, g\xF6rsel \xE7\xF6z\xFCn\xFCrl\xFCk
    art\u0131rma, filigran kald\u0131rma, h\u0131zl\u0131 \xFCretim.\n\nCreator Plan:\nAyl\u0131k
    19.99$, y\u0131ll\u0131k 199$; y\u0131lda 4.800 kredi, s\u0131n\u0131rs\u0131z
    ger\xE7ek zamanl\u0131 g\xF6rsel \xFCretimi, video olu\u015Fturma, g\xF6rsel
    \xE7\xF6z\xFCn\xFCrl\xFCk art\u0131rma, filigran kald\u0131rma, daha h\u0131zl\u0131
    \xFCretim, AI karakter olu\u015Fturma, ticari lisans, iste\u011Fe ba\u011Fl\u0131
    g\xFCvenlik filtresi.\n\nDirector Plan:\nAyl\u0131k 29.99$, y\u0131ll\u0131k
    299$; y\u0131lda 12.000 kredi, s\u0131n\u0131rs\u0131z ger\xE7ek zamanl\u0131
    g\xF6rsel \xFCretimi, video olu\u015Fturma, g\xF6rsel \xE7\xF6z\xFCn\xFCrl\xFCk
    art\u0131rma, filigran kald\u0131rma, en h\u0131zl\u0131 \xFCretim, AI karakter
    olu\u015Fturma, ticari lisans, iste\u011Fe ba\u011Fl\u0131 g\xFCvenlik filtresi."
