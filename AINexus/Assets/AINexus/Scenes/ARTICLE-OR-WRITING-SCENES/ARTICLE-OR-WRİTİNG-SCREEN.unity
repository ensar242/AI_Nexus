  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Fiyatland\u0131rma (2025 itibar\u0131yla)\n\nShepherd AI'nin fiyatland\u0131rma
    planlar\u0131 hakk\u0131nda resmi bir bilgi bulunmamaktad\u0131r. Ancak, platformun
    temel \xF6zelliklerine \xFCcretsiz eri\u015Fim sa\u011Flad\u0131\u011F\u0131
    ve baz\u0131 geli\u015Fmi\u015F \xF6zellikler i\xE7in premium planlar sundu\u011Fu
    bilinmektedir. Detayl\u0131 ve g\xFCncel fiyatland\u0131rma bilgileri i\xE7in
    resmi web sitesini ziyaret etmeniz \xF6nerilir"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
