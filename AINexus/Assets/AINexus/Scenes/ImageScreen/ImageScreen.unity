  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n\n\n\n\n\nMeshy AI, metin ve g\xF6rsellerden h\u0131zl\u0131 bir \u015Fekilde
    3D modeller olu\u015Fturan yapay zeka destekli bir platformdur. Oyun geli\u015Ftiricileri,
    3D sanat\xE7\u0131lar, XR i\xE7erik \xFCreticileri ve 3D bask\u0131 merakl\u0131lar\u0131
    i\xE7in tasarlanm\u0131\u015Ft\u0131r. Karma\u015F\u0131k modelleme s\xFCre\xE7lerini
    basitle\u015Ftirerek, kullan\u0131c\u0131lar\u0131n yarat\u0131c\u0131 fikirlerini
    h\u0131zl\u0131ca 3D modellere d\xF6n\xFC\u015Ft\xFCrmelerine olanak tan\u0131r."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
