  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "* Ger\xE7ek Zamanl\u0131 Bilgi Sunumu: Perplexity AI, kullan\u0131c\u0131lar\u0131n
    sorular\u0131na an\u0131nda yan\u0131t vererek bilgiye h\u0131zl\u0131 eri\u015Fim
    sa\u011Flar.\n\n* Kaynakl\u0131 Yan\u0131tlar: Verilen yan\u0131tlar, g\xFCvenilir
    kaynaklara dayand\u0131r\u0131larak sunulur, b\xF6ylece kullan\u0131c\u0131lar
    bilginin do\u011Frulu\u011Funu kolayca teyit edebilir. \nBilgi.net\n\n* Geli\u015Fmi\u015F
    Model Se\xE7enekleri: Kullan\u0131c\u0131lar, GPT-4 Turbo, Claude 3 ve Sonar
    32k gibi farkl\u0131 yapay zeka modelleri aras\u0131ndan se\xE7im yapabilirler.
    \nSivil Alan\n\n* Dosya Y\xFCkleme ve Y\xF6netimi: Kullan\u0131c\u0131lar, Excel,
    Word, PDF gibi dosyalar\u0131 y\xFCkleyerek bu belgeler \xFCzerinde arama yapabilirler.
    \nVikipedi\n\n* Perplexity Assistant: iOS ve Android cihazlarda kullan\u0131labilen
    bu asistan, \xE7oklu g\xF6revleri y\xF6netebilir ve kullan\u0131c\u0131lar\u0131n
    \xE7evresel sorular\u0131na yan\u0131t verebiilir\n\n* Se\xE7ti\u011Fin kayna\u011F\u0131n
    \xFCzerinden ara\u015Ft\u0131rmalar yapan ve genel akademiik yaz\u0131 haz\u0131rlayabilece\u011Finiz
    genel bir yapay zeka."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
