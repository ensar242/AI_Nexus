  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Perplexity AI, kullan\u0131c\u0131lar\u0131n sorular\u0131na ger\xE7ek
    zamanl\u0131, kaynakl\u0131 ve g\xFCvenilir yan\u0131tlar sunan yapay zeka destekli
    bir arama ve bilgi asistan\u0131d\u0131r. 2022 y\u0131l\u0131nda Aravind Srinivas,
    Denis Yarats, Johnny Ho ve Andy Konwinski taraf\u0131ndan kurulan bu platform,
    GPT-3.5 ve GPT-4 gibi b\xFCy\xFCk dil modelleriyle \xE7al\u0131\u015Farak, kullan\u0131c\u0131lar\u0131n
    bilgiye h\u0131zl\u0131 ve do\u011Fru bir \u015Fekilde ula\u015Fmas\u0131n\u0131
    sa\u011Flar."
  m_isRightToLeft: 0
