      m_Calls: []
  m_text: "* Metinden Videoya: Blog yaz\u0131lar\u0131, senaryolar veya k\u0131sa
    a\xE7\u0131klamalardan otomatik video \xFCretimi.\n\n* AI Edit\xF6r: Ger\xE7ek
    zamanl\u0131 sahne d\xFCzenleme, m\xFCzik e\u015Fle\u015Ftirme ve anlat\u0131m
    ekleme.\n\n* Yapay Zeka Seslendirme: Farkl\u0131 dillerde ve tonlamalarda do\u011Fal
    seslerle otomatik dublaj.\n\n* Haz\u0131r \u015Eablonlar: Y\xFCzlerce profesyonel
    video \u015Fablonu ile kolay ki\u015Fiselle\u015Ftirme.\n\n* Medya K\xFCt\xFCphanesi:
    Milyonlarca stok g\xF6rsel, video ve m\xFCzik i\xE7eriklerine eri\u015Fim."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
