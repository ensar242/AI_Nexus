      m_Calls: []
  m_text: "\n\n\n\n\n\n\nOpenAI Sora, metin girdilerine dayal\u0131 olarak ger\xE7ek\xE7i
    ve y\xFCksek kaliteli videolar \xFCreten yapay zek\xE2 destekli bir video \xFCretim
    modelidir. Sora, dogal dil a\xE7\u0131klamalar\u0131yla sahneleri, karakterleri,
    hareketleri ve ortamlar\u0131 anlay\u0131p, birka\xE7 saniyeden bir dakikaya
    kadar s\xFCren videolar olusturabilir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
